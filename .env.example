# Copie para .env (que NÃO é versionado): cp .env.example .env
APP_ENV=local
LOG_LEVEL=INFO
TIMEZONE=America/Sao_Paulo
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

POSTGRES_USER=fogo
POSTGRES_PASSWORD=fogo-local-dev
POSTGRES_DB=fogo
POSTGRES_HOST_PORT=5544
API_HOST_PORT=8000
WEB_HOST_PORT=8080

# Usado ao rodar fora do Docker (testes/desenvolvimento local). No compose é sobrescrito.
DATABASE_URL=postgresql+psycopg://fogo:fogo-local-dev@localhost:5544/fogo
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=15000

# Gere uma chave forte: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=troque-por-uma-chave-aleatoria-de-48-caracteres-ou-mais
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

HTTP_TIMEOUT_SECONDS=3
MAINTENANCE_DUE_SOON_DAYS=7
PREVENTIVE_JOB_HOUR=3

# Gateway IoT (simulador) — chave enviada no cabeçalho X-Gateway-Key.
IOT_GATEWAY_KEY=troque-por-uma-chave-do-gateway-iot
ALERT_SWEEP_INTERVAL_SECONDS=60
TELEMETRY_RETENTION_DAYS=90

# Simulador da cidade (dispositivos IoT + GPS das equipes). false = cidade "silenciosa".
SIMULATOR_ENABLED=true
SIMULATOR_TICK_SECONDS=5
SIMULATOR_HEARTBEAT_SECONDS=30
SIMULATOR_MEAN_SECONDS_BETWEEN_FAULTS=180

# Primeiro administrador (criado pelo serviço "migrate" se ainda não existir).
FIRST_ADMIN_EMAIL=admin@fogo.dev
FIRST_ADMIN_PASSWORD=Fogo@2026
FIRST_ADMIN_NAME=Administrador F.O.G.O.

# Dados de demonstração de Marília-SP (regiões, órgãos, ~300 equipamentos, ~120 agentes).
SEED_DEMO_DATA=true
DEMO_USERS_PASSWORD=Fogo@2026

# Parte 3 — Cidade Preditiva e PROMETHEUS
PREDICTION_REFRESH_MINUTES=5
ANOMALY_SCAN_SECONDS=60
PROMETHEUS_CYCLE_SECONDS=60
# Chave Fernet que cifra, no banco, a chave de API do modelo de IA cadastrada na tela.
# Gere a sua: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_ENCRYPTION_KEY=HhoMTmES3qhlncy3P34SglG9cIKX8yZISKZqbigrG30=
AI_TIMEOUT_SECONDS=30
