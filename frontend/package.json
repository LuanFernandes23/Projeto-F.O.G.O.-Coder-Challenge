    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.31",
    "prettier": "3.9.10",
    "tailwindcss": "3.4.19",
