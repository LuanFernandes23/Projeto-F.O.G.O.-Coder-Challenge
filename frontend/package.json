    "lucide-react": "0.577.0",
    "motion": "11.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "react-leaflet-cluster": "2.1.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "rehype-slug": "6.0.0",
    "remark-gfm": "4.0.1",
    "sonner": "1.7.4",
